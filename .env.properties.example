# 이 파일을 .env.properties 로 복사한 뒤 값을 채운다.
#   cp .env.properties.example .env.properties
# application.yml 이 optional:file:.env.properties 로 읽는다.

# MySQL (docker run -p 3307:3306 ... mysql:8 기준)
MYSQL_PASSWORD=

# JWT 서명 키. HS256 이라 최소 32바이트 이상이어야 한다.
#   openssl rand -base64 48
JWT_SECRET=

# 카카오 로그인 — https://developers.kakao.com 에서 발급
# 리다이렉트 URI 에 http://localhost:8080/login/oauth2/code/kakao 를 등록해야 한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 온통청년 공공 API — https://www.youthcenter.go.kr 에서 발급
YOUTH_CENTER_API_KEY=

# Google AI Studio — https://aistudio.google.com/apikey
# 채팅(gemini-2.5-flash)과 임베딩(gemini-embedding-001)에 함께 쓰인다.
GEMINI_API_KEY=

# 로그인 성공 후 프론트엔드로 돌아올 주소. 비워두면 아래 기본값이 쓰인다.
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth/callback
